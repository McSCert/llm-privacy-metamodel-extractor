<?xml version='1.0' encoding='UTF-8'?>
<pp:PrivacyPolicy xmlns:xmi="http://www.omg.org/XMI" xmlns:pp="http://www.example.org/privacypolicy" policyId="" version="1.0" validTo="9999999999" xmi:version="2.0">
  <statements statementId="" description="Processing personal information for business purposes under PIPEDA with consent requirements and purpose limitations.">
    <actor actorId="" name="Organization" role="DataController"/>
    <purposes purposeId="" description="Organizations using personal information for a new purpose shall document this purpose."/>
    <processingActivity activityId="" description="Processing personal information for business or activity purposes." action="Use">
      <dataProcessed dataId="" description="personal data of data subjects" source="DataSubject" category="Identifier" sensitivity="Medium" identifiability="Identified"/>
    </processingActivity>
    <legalBasis basisId="" type="Consent" evidence="An individual may withdraw consent at any time, subject to legal or contractual restrictions and reasonable notice.">
      <jurisdiction jurisdictionId="CA" name="Canada" description="PIPEDA jurisdiction"/>
    </legalBasis>
    <governingRegulations regulationId="" name="PIPEDA" version="" description="Personal Information Protection and Electronic Documents Act">
      <jurisdiction jurisdictionId="CA" name="Canada" description="Personal Information Protection and Electronic Documents Act"/>
    </governingRegulations>
    <constraints constraintId="" type="PurposeLimitation" expression="The Commissioner and every person acting on behalf or under the direction of the Commissioner shall not disclose information subject to a certificate issued under section 38.13 or 38.41 of the Canada Evidence Act, and shall take every reasonable precaution to avoid the disclosure of that information." enforcementLevel="Mandatory"/>
  </statements>
</pp:PrivacyPolicy>
