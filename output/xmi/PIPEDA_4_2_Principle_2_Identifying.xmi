<?xml version='1.0' encoding='UTF-8'?>
<pp:PrivacyPolicy xmlns:xmi="http://www.omg.org/XMI" xmlns:pp="http://www.example.org/privacypolicy" policyId="" version="1.0" validTo="9999999999" xmi:version="2.0">
  <statements statementId="" description="Organization's collection of personal information within a province with substantially similar legislation">
    <actor actorId="" name="Organization" role="DataController"/>
    <purposes purposeId="" description="Organizations using personal information for a new purpose shall document this purpose." category="ServiceProvision"/>
    <processingActivity activityId="" description="Collection of personal information within a province with substantially similar legislation" action="Collect">
      <dataProcessed dataId="" description="personal data of data subjects" source="DataSubject" category="Identifier" sensitivity="Medium" identifiability="Identified"/>
    </processingActivity>
    <legalBasis basisId="" type="Consent" evidence="The knowledge and consent of the individual are required for the collection, use, or disclosure of personal information, except where inappropriate.">
      <jurisdiction jurisdictionId="CA" name="Canada" description="PIPEDA jurisdiction"/>
    </legalBasis>
    <governingRegulations regulationId="" name="PIPEDA" version="" description="">
      <jurisdiction jurisdictionId="CA" name="Canada" description="Personal Information Protection and Electronic Documents Act"/>
    </governingRegulations>
    <constraints constraintId="" type="Security" expression="The Commissioner and every person acting on behalf or under the direction of the Commissioner shall not disclose information subject to a certificate issued under section 38.13 or 38.41 of the Canada Evidence Act, and shall take every reasonable precaution to avoid the disclosure of that information." enforcementLevel="Mandatory"/>
    <rightImpacted rightId="" type="Access" triggerCondition="data subject makes a request under PIPEDA Principle 2" fulfillmentProcess="controller must respond within the time limit and inform the individual in writing of refusal, setting out reasons and any recourse"/>
  </statements>
</pp:PrivacyPolicy>
