<?xml version='1.0' encoding='UTF-8'?>
<pp:PrivacyPolicy xmlns:xmi="http://www.omg.org/XMI" xmlns:pp="http://www.example.org/privacypolicy" policyId="" version="1.0" validTo="9999999999" xmi:version="2.0">
  <statements statementId="" description="Organization's transfer of personal data to third parties for processing">
    <actor actorId="" name="Organization" role="DataController"/>
    <purposes purposeId="" description="Organization transfers personal data to third parties for processing services."/>
    <processingActivity activityId="" description="Organization is responsible for personal information transferred to a third party for processing." action="Transfer">
      <dataProcessed dataId="" description="personal data of data subjects" source="DataSubject" sensitivity="Medium"/>
    </processingActivity>
    <legalBasis basisId="" evidence="The knowledge and consent of the individual are required for the collection, use, or disclosure of personal information, except where inappropriate.">
      <jurisdiction jurisdictionId="CA" name="Canada" description="PIPEDA jurisdiction"/>
    </legalBasis>
    <governingRegulations regulationId="" name="PIPEDA" version="" description="">
      <jurisdiction jurisdictionId="CA" name="Canada" description="Personal Information Protection and Electronic Documents Act"/>
    </governingRegulations>
    <constraints constraintId="" expression="The Commissioner shall, within 10 days after the certificate is published in the Canada Gazette, return the information to the organization that provided the information." enforcementLevel="Mandatory"/>
    <rightImpacted rightId="" triggerCondition="Upon written request by data subject" fulfillmentProcess="Organization must respond within 30 days"/>
  </statements>
</pp:PrivacyPolicy>
