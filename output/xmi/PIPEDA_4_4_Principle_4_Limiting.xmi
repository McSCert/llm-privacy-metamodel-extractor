<?xml version='1.0' encoding='UTF-8'?>
<pp:PrivacyPolicy xmlns:xmi="http://www.omg.org/XMI" xmlns:pp="http://www.example.org/privacypolicy" policyId="" version="1.0" validTo="9999999999" xmi:version="2.0">
  <statements statementId="" description="Limiting collection and use of personal data">
    <actor actorId="" name="" role="DataController"/>
    <purposes purposeId="" description="To comply with PIPEDA's principles" category="LegalCompliance"/>
    <processingActivity activityId="" description="Use personal data for the purpose of complying with PIPEDA" action="Use">
      <dataProcessed dataId="" description="Personal data of data subjects" source="Directly from data subject" category="Identifier" sensitivity="Low" identifiability="Identified"/>
    </processingActivity>
    <legalBasis basisId="" type="LegalObligation" evidence="">
      <jurisdiction jurisdictionId="CA" name="Canada" description="Personal Information Protection and Electronic Documents Act"/>
    </legalBasis>
    <governingRegulations regulationId="" name="PIPEDA" version="" description="">
      <jurisdiction jurisdictionId="CA" name="Canada" description="Personal Information Protection and Electronic Documents Act"/>
    </governingRegulations>
    <constraints constraintId="" type="PurposeLimitation" expression="Personal data must only be used for the purpose identified at time of collection." enforcementLevel="Mandatory"/>
    <rightImpacted rightId="" type="Access" triggerCondition="Upon written request by data subject" fulfillmentProcess="Organization must respond within 30 days"/>
  </statements>
</pp:PrivacyPolicy>
