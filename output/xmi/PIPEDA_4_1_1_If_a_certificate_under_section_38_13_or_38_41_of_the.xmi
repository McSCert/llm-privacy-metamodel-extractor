<?xml version='1.0' encoding='UTF-8'?>
<pp:PrivacyPolicy xmlns:xmi="http://www.omg.org/XMI" xmlns:pp="http://www.example.org/privacypolicy" policyId="" version="1.0" validTo="9999999999" xmi:version="2.0">
  <statements statementId="" description="Compliance with PIPEDA for personal information collection">
    <actor actorId="" name="Organization" role="DataController"/>
    <purposes purposeId="" description="for the purpose of clause 4.3" category="LegalCompliance"/>
    <processingActivity activityId="" description="Collection of personal information" action="Collect">
      <dataProcessed dataId="" description="personal data of data subjects" source="DataSubject" category="Identifier" sensitivity="Medium" identifiability="Identified"/>
    </processingActivity>
    <legalBasis basisId="" type="LegalObligation" evidence="">
      <jurisdiction jurisdictionId="" name="" description=""/>
    </legalBasis>
    <governingRegulations regulationId="" name="PIPEDA" version="" description="">
      <jurisdiction jurisdictionId="CA" name="Canada" description="Personal Information Protection and Electronic Documents Act"/>
    </governingRegulations>
    <constraints constraintId="" type="Security" expression="The Commissioner and every person acting on behalf or under the direction of the Commissioner shall not disclose information subject to a certificate issued under section 38.13 or 38.41 of the Canada Evidence Act, and shall take every reasonable precaution to avoid the disclosure of that information." enforcementLevel="Mandatory"/>
    <rightImpacted rightId="" type="Access" triggerCondition="data subject makes a request under PIPEDA section 4.9" fulfillmentProcess="organization must respond within time limit and provide access unless prohibited by subsection 9(1)"/>
  </statements>
</pp:PrivacyPolicy>
